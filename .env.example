QQQ_TICKER=QQQ
# Alpaca Market Data API (https://data.alpaca.markets). Paper/live trading hosts are unrelated.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional overrides (defaults shown).
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# ALPACA_DATA_FEED=iex
# Optional local soft budget for Discord usage warnings (0 = off).
ALPACA_MONTHLY_LIMIT=0
# Discord warning once per month when tracked usage reaches this % of soft budget (0 = off).
ALPACA_USAGE_WARN_PCT=80

# --- Optional Alpaca *paper* order execution (separate from Robinhood; live trading disabled) ---
# Requires ALPACA_PAPER_TRADING=true AND DRY_RUN=false to submit limit orders to paper-api.
ALPACA_PAPER_TRADING=false
# ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Buy size: fixed USD notional (used when ALPACA_PAPER_EQUITY_PCT is 0).
ALPACA_PAPER_NOTIONAL=500
# If > 0, buy size = paper equity × this fraction (e.g. 0.02 = 2%) instead of fixed notional.
ALPACA_PAPER_EQUITY_PCT=0
# Limit price offset vs latest trade, in basis points (buy above / sell below).
ALPACA_PAPER_LIMIT_OFFSET_BPS=10
# Volatility sizing is off by default. When false, buys use ALPACA_PAPER_NOTIONAL
# (or ALPACA_PAPER_EQUITY_PCT when that is > 0). When true, buy notional =
# min(equity * ALPACA_PAPER_RISK_FRACTION / stop_distance, ALPACA_PAPER_NOTIONAL).
# stop_distance is STOP_LOSS_PCT, or (ALPACA_PAPER_ATR_STOP_MULT * QQQ ATR / QQQ price)
# when ALPACA_PAPER_VOL_STOP=atr. No Kelly. No martingale. Missing equity falls back
# to ALPACA_PAPER_NOTIONAL.
ALPACA_PAPER_VOL_SIZING=false
ALPACA_PAPER_RISK_FRACTION=0.0075
# stop_pct (default) or atr
ALPACA_PAPER_VOL_STOP=stop_pct
ALPACA_PAPER_ATR_STOP_MULT=2

DISCORD_WEBHOOK_URL=
# Live mode: set DRY_RUN=false (Discord webhook required by main when not dry-run)
DRY_RUN=true

BULL_ENTRY_THRESHOLD=5
BEAR_ENTRY_THRESHOLD=5
WEAK_SCORE_THRESHOLD=3
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.15
# Display / research only. Not an automatic exit (see EXIT_MODE).
STRETCH_TAKE_PROFIT_PCT=0.25
# fixed (default): stop % and TAKE_PROFIT_PCT can exit. atr_trail: ATR trailing stop
# replaces the fixed take-profit exit. Stretch is never an exit.
EXIT_MODE=fixed
ATR_TRAIL_MULT=2
# Research fill haircut (QQQ proxy). Guide: open/close fills are worse than the print.
# Applied in --backtest / --strategy-eval / sweeps. Live alerts do not use these.
BACKTEST_ENTRY_SLIPPAGE_BPS=10
BACKTEST_EXIT_SLIPPAGE_BPS=10
MAX_HOLD_TRADING_DAYS=10
ENTRY_ATR_MULTIPLIER=0.5

# Weighted checklist (8 comma-separated weights; leave blank for all 1.0 — matches legacy equal weights).
# SCORE_WEIGHTS=1.2,1.2,1,1,1,1,1,0.8

# Regime / flip tuning (see README).
REGIME_SEP_ATR_MULT=0.12
REGIME_SLOPE_ATR_MULT=0.03
REGIME_RANGING_THRESHOLD_WEIGHT_ADD=0.55
REGIME_TREND_FAVORABLE_DELTA=0.5
FLIP_MIN_HOLD_TRADING_DAYS=3
FLIP_MARGIN_WEIGHT=1.25

# Weighted-units lead required for dominance fallback entry when strict gates fail (0 = disable legacy-only gates).
ENTRY_DOMINANCE_GAP_WEIGHT=1.25

# When false (default), reversal FLIPs are suppressed in range/chop; exits still use weaken / SL / TP / max hold.
FLIP_ALLOW_IN_RANGE=false

# Minimum stack-dominance confidence (0-100) for flat BUY TQQQ/SQQQ; below threshold → CASH. Use 0 to disable.
# Default 62 matches walk-forward best row (rank 1 by avg_score in reports/walk_forward_results.csv).
MIN_CONFIDENCE_TO_TRADE=62

# Optional backtest grid sweep (comma-separated lists). Used only with `python main.py --backtest-sweep`.
# BACKTEST_SWEEP_BULL=3,4,5
# BACKTEST_SWEEP_BEAR=3,4,5
# BACKTEST_SWEEP_WEAK=2,3
# BACKTEST_SWEEP_RANGE_ADD=0.0,0.25,0.5
# BACKTEST_SWEEP_FLIP_HOLD=0,1,2
# BACKTEST_SWEEP_FLIP_MARGIN=0.0,0.5,1.0
# BACKTEST_SWEEP_DOM_GAP=1.0,1.25,1.5
# BACKTEST_SWEEP_MIN_CONFIDENCE=55,60,65,70,75
# BACKTEST_SWEEP_STOP=0.08,0.10
# BACKTEST_SWEEP_TAKE_PROFIT=0.15,0.22
# Legacy long names (BACKTEST_SWEEP_BULL_ENTRY_THRESHOLD, etc.) still work if short names are unset.

# Walk-forward grid (research only; use with `python main.py --walk-forward`). Omit a row to keep the single value from your baseline vars above.
# WALK_FORWARD_FOLDS=3
# WALK_FORWARD_GRID_MIN_CONFIDENCE=55,62,70
# WALK_FORWARD_GRID_DOM_GAP=1.0,1.25
# WALK_FORWARD_GRID_RANGE_ADD=0.55,0.65
# WALK_FORWARD_GRID_FLIP_HOLD=3
# WALK_FORWARD_GRID_FLIP_MARGIN=1.25,1.5
# WALK_FORWARD_GRID_FLIP_ALLOW_IN_RANGE=false,true

JOURNAL_CSV=alerts_journal.csv
# Append-only paper order journal for self-learning (JSONL under gitignored logs/).
TRADE_LOG_JSONL=logs/trades.jsonl
# file (default, local) or supabase (required on Render Cron — ephemeral disk)
POSITION_STATE_BACKEND=file
POSITION_STATE_JSON=position_state.json
# Row key in public.bot_position_state when POSITION_STATE_BACKEND=supabase
POSITION_STATE_BOT_ID=default
EVENTS_JSON=events.json

# Optional: merge CPI/FOMC/major Nasdaq earnings dates (events.json risk_calendar + optional URL).
# Guide: keep blackouts on for new entries. When disabled or data is missing/unreachable,
# entries behave like manual blocked_dates only (never fatal).
EVENT_RISK_AVOIDANCE=true
EVENT_RISK_CALENDAR_URL=

ANCHOR_DATE=

# --- Dashboard technical snapshots (optional; does not affect the alert bot) ---
# Symbols scored by `python publish_technical_dashboard.py` (comma-separated). Falls back to NEWS_INGEST_TICKERS when unset.
# TECHNICAL_UNIVERSE=QQQ,SPY,AAPL,MSFT,NVDA

# Supabase project URL + service role key (same values as dashboard/.env.local; either NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL works).
# Required when POSITION_STATE_BACKEND=supabase (Render) and for publish_technical_dashboard.py.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: after a successful publish, POST /api/technical/revalidate with Bearer CRON_SECRET (matches dashboard CRON_SECRET).
# DASHBOARD_BASE_URL=http://localhost:3000
