QQQ_TICKER=QQQ
# Alpaca Market Data API (https://data.alpaca.markets). Paper/live trading hosts are unrelated.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional overrides (defaults shown).
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# ALPACA_DATA_FEED=iex
# Optional local soft budget for Discord usage warnings (0 = off).
ALPACA_MONTHLY_LIMIT=0
# Discord warning once per month when tracked usage reaches this % of soft budget (0 = off).
ALPACA_USAGE_WARN_PCT=80

# --- Optional Alpaca *paper* order execution (separate from Robinhood; live trading disabled) ---
# Requires ALPACA_PAPER_TRADING=true AND DRY_RUN=false to submit limit orders to paper-api.
# For weekday learning crons (Render env group + local scripts/run_weekday_paper.py):
#   ALPACA_PAPER_TRADING=true
#   DRY_RUN=false
#   ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets   # live host is rejected
# Never set ALPACA_TRADING_BASE_URL=https://api.alpaca.markets (blocked).
# Robinhood agentic path is review-only (`python main.py --rh-preview`).
# This process never calls place_equity_order. Connect a dedicated agentic
# account yourself at https://agent.robinhood.com/mcp/trading and keep
# Trade approvals ON. RH_AGENT_MAX_NOTIONAL=200  RH_AGENT_TQQQ_ONLY=true
ALPACA_PAPER_TRADING=false
# ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Fallback USD size per buy when ALPACA_PAPER_EQUITY_PCT is 0, or when equity %
# is on but paper equity cannot be fetched (also the cap for volatility sizing).
ALPACA_PAPER_NOTIONAL=500
# Fraction of Alpaca paper equity per buy (0.15 = 15%). NOT a whole percent —
# paste 0.15, never 15 (15 would mean 15× equity; config rejects values > 1).
# 0 = off (fixed ALPACA_PAPER_NOTIONAL). Render env group ships 0.15; PAPER_MAX_BUY_NOTIONAL
# still clamps the result (Render hard cap 300 USD).
ALPACA_PAPER_EQUITY_PCT=0.15
# Limit price offset vs latest trade, in basis points (buy above / sell below).
ALPACA_PAPER_LIMIT_OFFSET_BPS=10
# Volatility sizing is off by default. When false, buys use ALPACA_PAPER_EQUITY_PCT
# when that is > 0, else ALPACA_PAPER_NOTIONAL. When true, buy notional =
# min(equity * ALPACA_PAPER_RISK_FRACTION / stop_distance, ALPACA_PAPER_NOTIONAL).
# stop_distance is STOP_LOSS_PCT, or (ALPACA_PAPER_ATR_STOP_MULT * QQQ ATR / QQQ price)
# when ALPACA_PAPER_VOL_STOP=atr. No Kelly. No martingale. Missing equity falls back
# to ALPACA_PAPER_NOTIONAL (then PAPER_MAX_BUY_NOTIONAL if that cap is on).
ALPACA_PAPER_VOL_SIZING=false
ALPACA_PAPER_RISK_FRACTION=0.0075
# stop_pct (default) or atr
ALPACA_PAPER_VOL_STOP=stop_pct
ALPACA_PAPER_ATR_STOP_MULT=2

# --- Paper-path risk controls (USD dollars; 0 = that gate OFF) ---
# Local default stays OFF. Render env group `tqqq-sqqq-alerts` ships gates ON
# (Path B paper only — never enable live Alpaca / api.alpaca.markets).
# Units: ALPACA_PAPER_EQUITY_PCT = fraction of paper equity (0.15 = 15%, not 15).
#        PAPER_MAX_BUY_NOTIONAL  = USD per buy (hard cap; not a percent).
#        PAPER_MAX_*_LOSS_USD    = USD sleeve loss vs prior close / week-start
#        (not percents). 0 disables that kill. Both TQQQ and SQQQ stay in one book.
# Render Dashboard paste (percent sizing ON, USD kills ON, ~$1,000 paper sleeve):
#   ALPACA_PAPER_EQUITY_PCT=0.15
#   PAPER_MAX_BUY_NOTIONAL=300
#   PAPER_MAX_DAILY_LOSS_USD=25
#   PAPER_MAX_WEEKLY_LOSS_USD=60
#   PAPER_TQQQ_ONLY=false
PAPER_MAX_BUY_NOTIONAL=0
PAPER_TQQQ_ONLY=false
# Kill switch: 0 = off. When >0, trip if equity drop vs prior close (daily) or
# week-start mark (weekly) reaches this USD loss. Tripped kill blocks new buys;
# sells still submit so an open lot can flatten. Posts Discord content "KILL".
PAPER_MAX_DAILY_LOSS_USD=0
PAPER_MAX_WEEKLY_LOSS_USD=0
# When a loss cap is on, account/history failure is UNKNOWN and blocks new buys
# (sells still allowed). Caps of 0 do not call the broker for the kill check.
# Newest hourly bar must have ended within this many minutes or new buys block.
# 0 disables the freshness gate. Default 90.
MARKET_DATA_MAX_AGE_MINUTES=90
# Fresh bid/ask preferred for limits. Stale or crossed quotes block new buys.
QUOTE_MAX_AGE_SECONDS=180
QUOTE_MAX_SPREAD_BPS=100
TRADE_MAX_AGE_SECONDS=900

DISCORD_WEBHOOK_URL=
# Live mode: set DRY_RUN=false (Discord webhook required by main when not dry-run)
DRY_RUN=true

BULL_ENTRY_THRESHOLD=5
BEAR_ENTRY_THRESHOLD=5
WEAK_SCORE_THRESHOLD=3
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.15
# Display / research only. Not an automatic exit (see EXIT_MODE).
STRETCH_TAKE_PROFIT_PCT=0.25
# fixed (default): stop % and TAKE_PROFIT_PCT can exit. atr_trail: ATR trailing stop
# replaces the fixed take-profit exit. Stretch is never an exit.
EXIT_MODE=fixed
ATR_TRAIL_MULT=2
# Research fill haircut (QQQ proxy). Guide: open/close fills are worse than the print.
# Applied in --backtest / --strategy-eval / sweeps. Live alerts do not use these.
BACKTEST_ENTRY_SLIPPAGE_BPS=10
BACKTEST_EXIT_SLIPPAGE_BPS=10
MAX_HOLD_TRADING_DAYS=10
ENTRY_ATR_MULTIPLIER=0.5

# Weighted checklist defaults (blank SCORE_WEIGHTS uses trend-tilted weights in strategy_params).
# Order: daily close>EMA20, EMA20>EMA50, RSI, MACD, 4h close>EMA20, 4h EMA20>EMA50, weekly VWAP, volume.
# SCORE_WEIGHTS=1.5,1.5,0.5,1,1.5,1.5,1,0.5
# Legacy equal weights (pre-adoption): SCORE_WEIGHTS=1,1,1,1,1,1,1,1

# Regime / flip tuning (see README).
REGIME_SEP_ATR_MULT=0.12
REGIME_SLOPE_ATR_MULT=0.03
REGIME_RANGING_THRESHOLD_WEIGHT_ADD=0.55
REGIME_TREND_FAVORABLE_DELTA=0.5
FLIP_MIN_HOLD_TRADING_DAYS=3
FLIP_MARGIN_WEIGHT=1.25

# Weighted-units lead required for dominance fallback entry when strict gates fail (0 = disable legacy-only gates).
ENTRY_DOMINANCE_GAP_WEIGHT=1.25

# When false (default), reversal FLIPs are suppressed in range/chop; exits still use weaken / SL / TP / max hold.
FLIP_ALLOW_IN_RANGE=false

# Minimum stack-dominance confidence (0-100) for flat BUY TQQQ/SQQQ; below threshold → CASH. Use 0 to disable.
# Default 62 matches walk-forward best row (rank 1 by avg_score in reports/walk_forward_results.csv).
MIN_CONFIDENCE_TO_TRADE=62

# Optional backtest grid sweep (comma-separated lists). Used only with `python main.py --backtest-sweep`.
# BACKTEST_SWEEP_BULL=3,4,5
# BACKTEST_SWEEP_BEAR=3,4,5
# BACKTEST_SWEEP_WEAK=2,3
# BACKTEST_SWEEP_RANGE_ADD=0.0,0.25,0.5
# BACKTEST_SWEEP_FLIP_HOLD=0,1,2
# BACKTEST_SWEEP_FLIP_MARGIN=0.0,0.5,1.0
# BACKTEST_SWEEP_DOM_GAP=1.0,1.25,1.5
# BACKTEST_SWEEP_MIN_CONFIDENCE=55,60,65,70,75
# BACKTEST_SWEEP_STOP=0.08,0.10
# BACKTEST_SWEEP_TAKE_PROFIT=0.15,0.22
# Legacy long names (BACKTEST_SWEEP_BULL_ENTRY_THRESHOLD, etc.) still work if short names are unset.

# Walk-forward grid (research only; use with `python main.py --walk-forward`). Omit a row to keep the single value from your baseline vars above.
# WALK_FORWARD_FOLDS=3
# WALK_FORWARD_GRID_MIN_CONFIDENCE=55,62,70
# WALK_FORWARD_GRID_DOM_GAP=1.0,1.25
# WALK_FORWARD_GRID_RANGE_ADD=0.55,0.65
# WALK_FORWARD_GRID_FLIP_HOLD=3
# WALK_FORWARD_GRID_FLIP_MARGIN=1.25,1.5
# WALK_FORWARD_GRID_FLIP_ALLOW_IN_RANGE=false,true

JOURNAL_CSV=alerts_journal.csv
# Append-only paper order journal for self-learning (JSONL under gitignored logs/).
TRADE_LOG_JSONL=logs/trades.jsonl
# file (default locally) or supabase (required on Render Cron — ephemeral disk).
# When unset, mirrors POSITION_STATE_BACKEND. supabase writes local JSONL AND inserts
# into public.bot_trade_log (same SUPABASE_* credentials as position memory).
TRADE_LOG_BACKEND=file
# Row key in public.bot_trade_log (defaults to POSITION_STATE_BOT_ID when unset).
# TRADE_LOG_BOT_ID=default
# file (default, local) or supabase (required on Render Cron — ephemeral disk)
POSITION_STATE_BACKEND=file
POSITION_STATE_JSON=position_state.json
# Row key in public.bot_position_state when POSITION_STATE_BACKEND=supabase
POSITION_STATE_BOT_ID=default
EVENTS_JSON=events.json

# Optional: merge CPI/FOMC/major Nasdaq earnings dates (events.json risk_calendar + optional URL).
# Guide: keep blackouts on for new entries. When disabled or data is missing/unreachable,
# entries behave like manual blocked_dates only (never fatal).
EVENT_RISK_AVOIDANCE=true
EVENT_RISK_CALENDAR_URL=

ANCHOR_DATE=

# --- Dashboard technical snapshots (optional; does not affect the alert bot) ---
# Symbols scored by `python publish_technical_dashboard.py` (comma-separated). Falls back to NEWS_INGEST_TICKERS when unset.
# TECHNICAL_UNIVERSE=QQQ,SPY,AAPL,MSFT,NVDA

# Supabase project URL + service role key (same values as dashboard/.env.local; either NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL works).
# Required when POSITION_STATE_BACKEND=supabase or TRADE_LOG_BACKEND=supabase (Render) and for publish_technical_dashboard.py.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Alpaca live shadow (optional; READ-ONLY; does not submit orders) ---
# Absent EXECUTION_BROKER keeps Alpaca paper. Do not set bare alpaca_live.
# Live shadow uses separate credentials. Paper keys are never reused.
# Even ALPACA_LIVE_ENABLED=true cannot submit on shadow — code barrier required.
# EXECUTION_BROKER=alpaca_live_shadow
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_API_SECRET=
# ALPACA_LIVE_TRADING_BASE_URL=https://api.alpaca.markets
# ALPACA_LIVE_MAX_POSITION_PCT=0.02
# ALPACA_LIVE_MAX_ORDER_NOTIONAL=100
# ALPACA_LIVE_CAPITAL_CEILING=1000
# ALPACA_LIVE_MAX_DAILY_LOSS_PCT=0.01
# ALPACA_LIVE_MAX_WEEKLY_LOSS_PCT=0.02
# ALPACA_LIVE_MAX_DRAWDOWN_PCT=0.05
# ALPACA_LIVE_MAX_ORDERS_PER_DAY=1
# ALPACA_LIVE_NEW_ENTRIES_ENABLED=false
# ALPACA_LIVE_ENABLED=false
# LIVE_TRADING_ENABLED=false
# ALPACA_LIVE_SHADOW_LOG=logs/alpaca_live_shadow.jsonl
# ALPACA_LIVE_CLAIM_LOG=logs/alpaca_live_claims.jsonl
#
# --- Alpaca live pilot (REAL MONEY; do not arm on Render by default) ---
# Merging pilot code does NOT activate live. All of the following are required
# before any live POST: EXECUTION_BROKER=alpaca_live_pilot, ALPACA_LIVE_ENABLED,
# ALPACA_LIVE_NEW_ENTRIES_ENABLED, LIVE_TRADING_ENABLED, Supabase claim +
# daily entry reservation tables, and ALPACA_LIVE_PILOT_SUBMISSION_IMPLEMENTED
# in code. Equity above ALPACA_LIVE_CAPITAL_CEILING blocks new exposure
# (no silent size-down). FLIP requires post-SELL broker refresh before BUY.
# EXECUTION_BROKER=alpaca_live_pilot
# ALPACA_LIVE_ENABLED=false
# ALPACA_LIVE_NEW_ENTRIES_ENABLED=false
# LIVE_TRADING_ENABLED=false
# ALPACA_LIVE_PILOT_LOG=logs/alpaca_live_pilot.jsonl
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Robinhood shadow (optional; does not submit orders) ---
# Absent EXECUTION_BROKER keeps Alpaca paper. Do not set robinhood_live.
# EXECUTION_BROKER=alpaca_paper
# EXECUTION_BROKER=robinhood_shadow
# Limits are fractions in (0, 1] or dollars. Unset capital limits block new buys.
# ROBINHOOD_LIVE_ENABLED is ignored. Live orders need a future code change.
# ROBINHOOD_LIVE_ENABLED=false
# ROBINHOOD_NEW_ENTRIES_ENABLED=false
# ROBINHOOD_MAX_POSITION_PCT=0.02
# ROBINHOOD_MAX_ORDER_NOTIONAL=100
# ROBINHOOD_MAX_DAILY_LOSS_PCT=0.01
# ROBINHOOD_MAX_WEEKLY_LOSS_PCT=0.02
# ROBINHOOD_MAX_DRAWDOWN_PCT=0.05
# ROBINHOOD_MAX_ORDERS_PER_DAY=1
# ROBINHOOD_SHADOW_LOG=logs/robinhood_shadow.jsonl
#
# Connected shadow still does not submit. Official Robinhood auth is OAuth
# inside an MCP host at https://agent.robinhood.com/mcp/trading. This cron
# cannot complete that flow. ROBINHOOD_MCP_URL and ROBINHOOD_MCP_TOKEN are
# ignored. Do not paste a token here. The reader stays offline and new
# exposure is blocked.
# EXECUTION_BROKER=robinhood_connected_shadow
# Example sleeve on the order of $100. Commented. Does not activate trading.
# ROBINHOOD_MAX_POSITION_PCT=0.10
# ROBINHOOD_MAX_ORDER_NOTIONAL=10
# ROBINHOOD_MAX_DAILY_LOSS_PCT=0.02
# ROBINHOOD_MAX_WEEKLY_LOSS_PCT=0.05
# ROBINHOOD_MAX_DRAWDOWN_PCT=0.10
# ROBINHOOD_MAX_ORDERS_PER_DAY=1
# Deprecated and ignored. Not official auth.
# ROBINHOOD_MCP_URL=
# ROBINHOOD_MCP_TOKEN=

# --- Robinhood host-mediated pilot (Case C; Render does NOT place RH orders) ---
# Auth is OAuth inside an MCP host at https://agent.robinhood.com/mcp/trading.
# Render may create PENDING intents only (EXECUTION_BROKER=robinhood_host_handoff).
# Real place_equity_order runs only via scripts/robinhood_execute_pending.py in an
# authenticated host with ROBINHOOD_HOST_EXECUTOR=true + multi-key arming.
# Kill switches default false. Capital ceiling is configurable (example 100).
# Do not arm on Render. Do not invent static API keys.
# EXECUTION_BROKER=robinhood_host_handoff
# ROBINHOOD_HOST_ENABLED=false
# ROBINHOOD_HOST_NEW_ENTRIES_ENABLED=false
# ROBINHOOD_HOST_LIVE_SUBMISSION=false
# ROBINHOOD_HOST_EXECUTOR=false
# LIVE_TRADING_ENABLED=false
# ROBINHOOD_HOST_CAPITAL_CEILING=100
# ROBINHOOD_HOST_MAX_POSITION_PCT=0.10
# ROBINHOOD_HOST_MAX_ORDER_NOTIONAL=100
# ROBINHOOD_HOST_MAX_DAILY_LOSS_PCT=0.02
# ROBINHOOD_HOST_MAX_WEEKLY_LOSS_PCT=0.05
# ROBINHOOD_HOST_MAX_DRAWDOWN_PCT=0.10
# ROBINHOOD_HOST_MAX_ORDERS_PER_DAY=1
# ROBINHOOD_HOST_ALLOW_FRACTIONAL=false
# ROBINHOOD_HOST_HANDOFF_LOG=logs/robinhood_host_handoff.jsonl
# ROBINHOOD_HOST_EXEC_LOG=logs/robinhood_host_exec.jsonl
# Apply migrations:
#   dashboard/supabase/migrations/20261007160000_bot_robinhood_execution_intents.sql
#   dashboard/supabase/migrations/20261007160100_bot_robinhood_entry_reservations.sql

# Optional: after a successful publish, POST /api/technical/revalidate with Bearer CRON_SECRET (matches dashboard CRON_SECRET).
# DASHBOARD_BASE_URL=http://localhost:3000
