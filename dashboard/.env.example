# Supabase (server reads/writes use service role — never expose to browser client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub https://finnhub.io (free tier has rate limits)
NEWS_API_KEY=
NEWS_PROVIDER=finnhub

# Comma-separated symbols for company-news pulls during ingest
NEWS_INGEST_TICKERS=QQQ,SPY,AAPL,MSFT,NVDA

# Optional: restrict regex ticker extraction to these symbols (comma-separated)
# NEWS_TICKER_ALLOWLIST=AAPL,MSFT,QQQ,SPY

# Shared secret for POST/GET /api/news/ingest (Vercel Cron sends Bearer CRON_SECRET automatically when env is set)
CRON_SECRET=

# Optional scoped route tokens (JSON array). If provided, tokens can be limited by scope.
# Scopes: news:ingest, technical:revalidate
# Example:
# ROUTE_AUTH_TOKENS_JSON=[{"token":"news-token","scopes":["news:ingest"],"principal":"vercel-cron"},{"token":"tech-token","scopes":["technical:revalidate"],"principal":"publisher-job"}]
ROUTE_AUTH_TOKENS_JSON=

# Technical leaderboard data comes from Supabase tables populated by the repo-root Python job:
#   python publish_technical_dashboard.py
# Uses KLICKANALYTICS_CLI_* + TECHNICAL_UNIVERSE from the repo root `.env` (see root `.env.example`).
# Optional: set DASHBOARD_BASE_URL to your deployed site URL (same host as this app) so the publisher can POST
# /api/technical/revalidate with Bearer CRON_SECRET and invalidate cached leaderboard reads.
